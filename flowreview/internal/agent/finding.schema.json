{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "excerpt": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "excerpt",
                "line",
                "path"
              ]
            }
          },
          "explanation": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "suggested_comment": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "confidence",
          "evidence",
          "explanation",
          "severity",
          "title"
        ]
      }
    }
  },
  "required": [
    "findings"
  ]
}
